{
  "name": "@readit/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "import:stv": "tsx src/scripts/import-stv.ts",
    "import:wordnet": "tsx src/scripts/import-wordnet.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.0.4",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^11.8.1",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^4.5.1",
    "fastify": "^5.2.1",
    "pdfjs-dist": "^4.10.38",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "optionalDependencies": {
    "wordnet-db": "^3.1.14"
  }
}
