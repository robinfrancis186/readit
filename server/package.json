{
  "name": "@readit/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:dictionaries": "tsx src/scripts/build-dictionaries.ts",
    "dev": "tsx watch src/index.ts",
    "import:stv": "tsx src/scripts/import-stv.ts",
    "start": "node dist/index.js",
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.4",
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.8.0",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "pdfjs-dist": "^4.10.38",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "wordnet-db": "^3.1.14",
    "yaml": "^2.9.0"
  }
}
